# ── Threads ───────────────────────────────────────────────────────────────
# ID da rede social Threads cadastrada no GuaIA
THREADS_QUERY_SOURCE=8

# Termo de busca padrão (usado apenas no CLI direto via collector.py)
SEARCH_TERM=

# Usuário alvo (opcional, coleta posts de um @username específico)
TARGET_USER=

# Quantidade de posts desejada por coleta
TARGET_POSTS=200

# Modo headless do Playwright (true recomendado em produção)
HEADLESS=true

# ── Autenticação Threads ──────────────────────────────────────────────────
# Credenciais para login no Threads. Sem login a busca retorna ~10 posts;
# autenticado a paginação libera mais resultados.
THREADS_USERNAME=
THREADS_PASSWORD=

# ── Comentários ───────────────────────────────────────────────────────────
FETCH_COMMENTS=false
THREADS_FETCH_COMMENTS=false
COMMENTS_PER_POST=50
COMMENTS_CONCURRENCY=3
THREADS_DOWNLOAD_MEDIA=false
THREADS_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=60
THREADS_MEDIA_MAX_BYTES=262144000
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=threads
POSTGRES_PASSWORD=threads_pass
POSTGRES_DB=threads_db
DB_PORT_EXTERNAL=5433

# ── Sufixo de ambiente (opcional, para múltiplas instâncias) ──────────────
SUFFIX=
